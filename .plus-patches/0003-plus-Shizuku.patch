+package top.miceworld.kdeconnectplus.shizuku
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/** 用假的接口模拟各 Android 版本 IClipboard 的方法形状。 */
+class ClipboardApiTest {
+    @Suppress("unused")
+    interface Android13 {
+        fun setPrimaryClip(clip: Any?, pkg: String?, userId: Int)
+        fun getPrimaryClip(pkg: String?, userId: Int): Any?
+        fun getPrimaryClipDescription(pkg: String?, userId: Int): Any?
+        fun addPrimaryClipChangedListener(listener: Any?, pkg: String?, userId: Int)
+        fun removePrimaryClipChangedListener(listener: Any?, pkg: String?, userId: Int)
+    }
+
+    @Suppress("unused")
+    interface Android14 {
+        fun setPrimaryClip(clip: Any?, pkg: String?, tag: String?, userId: Int, deviceId: Int)
+        fun getPrimaryClip(pkg: String?, tag: String?, userId: Int, deviceId: Int): Any?
+        fun getPrimaryClipDescription(pkg: String?, tag: String?, userId: Int, deviceId: Int): Any?
+        fun addPrimaryClipChangedListener(listener: Any?, pkg: String?, tag: String?, userId: Int, deviceId: Int)
+        fun removePrimaryClipChangedListener(listener: Any?, pkg: String?, tag: String?, userId: Int, deviceId: Int)
+    }
+
+    /** 某个 ROM 只改了一个方法：不能混用两套签名。 */
+    @Suppress("unused")
+    interface Mixed {
+        fun getPrimaryClip(pkg: String?, tag: String?, userId: Int, deviceId: Int): Any?
+        fun getPrimaryClipDescription(pkg: String?, userId: Int): Any?
+        fun addPrimaryClipChangedListener(listener: Any?, pkg: String?, tag: String?, userId: Int, deviceId: Int)
+        fun removePrimaryClipChangedListener(listener: Any?, pkg: String?, tag: String?, userId: Int, deviceId: Int)
+    }
+
+    @Test
+    fun legacySignature() {
+        val methods = ClipboardApi.findMethods(Android13::class.java)!!
+        assertFalse(methods.withAttribution)
+        assertEquals(2, methods.getPrimaryClip.parameterCount)
+        assertEquals(3, methods.addListener.parameterCount)
+        assertEquals(3, methods.setPrimaryClip!!.parameterCount)
+    }
+
+    @Test
+    fun modernSignature() {
+        val methods = ClipboardApi.findMethods(Android14::class.java)!!
+        assertTrue(methods.withAttribution)
+        assertEquals(4, methods.getPrimaryClipDescription.parameterCount)
+        assertEquals(5, methods.removeListener.parameterCount)
+        assertEquals(5, methods.setPrimaryClip!!.parameterCount)
+    }
+
+    /** 找不到写入方法时仍然可以读和监听。 */
+    @Suppress("unused")
+    interface ReadOnly {
+        fun getPrimaryClip(pkg: String?, userId: Int): Any?
+        fun getPrimaryClipDescription(pkg: String?, userId: Int): Any?
+        fun addPrimaryClipChangedListener(listener: Any?, pkg: String?, userId: Int)
+        fun removePrimaryClipChangedListener(listener: Any?, pkg: String?, userId: Int)
+    }
+
+    @Test
+    fun missingSetPrimaryClip() {
+        assertNull(ClipboardApi.findMethods(ReadOnly::class.java)!!.setPrimaryClip)
+    }
+
+    @Test
+    fun unknownSignature() {
+        assertNull(ClipboardApi.findMethods(Mixed::class.java))
+        assertNull(ClipboardApi.findMethods(Runnable::class.java))
+    }
+}
diff --git a/plus/shizuku-clipboard/src/test/java/top/miceworld/kdeconnectplus/shizuku/ShellClipboardMainTest.kt b/plus/shizuku-clipboard/src/test/java/top/miceworld/kdeconnectplus/shizuku/ShellClipboardMainTest.kt
new file mode 100644
index 00000000..e3793db0
--- /dev/null
+++ b/plus/shizuku-clipboard/src/test/java/top/miceworld/kdeconnectplus/shizuku/ShellClipboardMainTest.kt
@@ -0,0 +1,61 @@
+package top.miceworld.kdeconnectplus.shizuku
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import java.io.ByteArrayInputStream
+import java.io.ByteArrayOutputStream
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.EOFException
+import java.io.IOException
+
+/** root 模式下剪贴板进程和父进程之间的管道协议。 */
+class ShellClipboardMainTest {
+    @Test
+    fun framesRoundTrip() {
+        val buffer = ByteArrayOutputStream()
+        val out = DataOutputStream(buffer)
+        ShellClipboardMain.writeStatus(out, ShellClipboardMain.FRAME_STATUS, BridgeStatus.UNSUPPORTED_SIGNATURE)
+        ShellClipboardMain.writeText(out, ShellClipboardMain.FRAME_CLIP, "密码 🔑\n第二行", sensitive = true)
+        ShellClipboardMain.writeText(out, ShellClipboardMain.FRAME_CLIP, "", sensitive = false)
+        ShellClipboardMain.writeText(out, ShellClipboardMain.FRAME_SET_TEXT, "来自电脑", sensitive = false)
+        ShellClipboardMain.writeStatus(out, ShellClipboardMain.FRAME_WRITTEN, 1)
+
+        val input = DataInputStream(ByteArrayInputStream(buffer.toByteArray()))
+        val status = ShellClipboardMain.readFrame(input)
+        assertEquals(ShellClipboardMain.FRAME_STATUS, status.type)
+        assertEquals(BridgeStatus.UNSUPPORTED_SIGNATURE, status.status)
+
+        val clip = ShellClipboardMain.readFrame(input)
+        assertEquals(ShellClipboardMain.FRAME_CLIP, clip.type)
+        assertEquals("密码 🔑\n第二行", clip.text)
+        assertTrue(clip.sensitive)
+
+        val empty = ShellClipboardMain.readFrame(input)
+        assertEquals("", empty.text)
+        assertFalse(empty.sensitive)
+
+        val set = ShellClipboardMain.readFrame(input)
+        assertEquals(ShellClipboardMain.FRAME_SET_TEXT, set.type)
+        assertEquals("来自电脑", set.text)
+
+        val written = ShellClipboardMain.readFrame(input)
+        assertEquals(ShellClipboardMain.FRAME_WRITTEN, written.type)
+        assertEquals(1, written.status)
+    }
+
+    @Test(expected = EOFException::class)
+    fun truncatedFrameFails() {
+        val buffer = ByteArrayOutputStream()
+        ShellClipboardMain.writeText(DataOutputStream(buffer), ShellClipboardMain.FRAME_CLIP, "hello", sensitive = false)
+        val bytes = buffer.toByteArray().copyOf(buffer.size() - 2)
+        ShellClipboardMain.readFrame(DataInputStream(ByteArrayInputStream(bytes)))
+    }
+
+    @Test(expected = IOException::class)
+    fun unknownFrameFails() {
+        ShellClipboardMain.readFrame(DataInputStream(ByteArrayInputStream(byteArrayOf(9))))
+    }
+}
